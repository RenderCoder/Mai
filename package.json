{
  "name": "mai",
  "version": "1.1.4",
  "description": "One short-name Codex and Claude Code skill for confirmed multilingual e-commerce copywriting",
  "type": "module",
  "scripts": {
    "dev": "claude --plugin-dir .",
    "install:codex": "bun run scripts/install-codex-skill.ts",
    "test": "bun test scripts/install-codex-skill.test.ts skills/mai/scripts/save-result.test.ts skills/mai/scripts/collect-product-source.test.ts skills/mai/scripts/check-version.test.ts skills/mai/scripts/update-installed.test.ts",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "validate": "bun run scripts/validate-skill.ts",
    "release:check": "bun run format && bun run validate && bun run test && bun run lint && bun skills/mai/scripts/check-version.ts --skip-remote && bun run install:codex -- --dry-run --codex-home /tmp/mai-codex-release-check"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "codex-skill",
    "ecommerce",
    "multilingual",
    "copywriting",
    "amazon",
    "localization"
  ],
  "author": "Bevis",
  "license": "MIT"
}
