{
  "name": "ecommerce-multilingual-copy",
  "version": "1.0.0",
  "description": "Codex and Claude Code skills for multilingual e-commerce copywriting with a 4-step reflective translation pipeline",
  "type": "module",
  "scripts": {
    "dev": "claude --plugin-dir .",
    "install:codex": "bun run scripts/install-codex-skill.ts",
    "test": "bun test",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "validate": "bun run scripts/validate-skill.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "codex-skill",
    "ecommerce",
    "multilingual",
    "copywriting",
    "amazon",
    "localization"
  ],
  "author": "Bevis",
  "license": "MIT"
}
